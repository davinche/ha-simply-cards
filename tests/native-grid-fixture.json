                            "entity": "lock.demo_9",
                            "name": "Front Door"
                          },
                          {
                            "entity": "lock.demo_8",
                            "name": "Back Door"
                          },
                          {
                            "entity": "cover.demo_2",
                            "name": "Garage",
                            "icon": "mdi:garage"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "screen",
                  "media_query": "(max-width: 719px)"
