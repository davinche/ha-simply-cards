{
  "views": [
    {
      "title": "Home (Components Test)",
      "path": "home-components-test",
      "icon": "mdi:home-outline",
      "background": "#F7F8FA",
      "type": "panel",
      "visible": [
        {
          "user": "synthetic-user"
        },
        {
          "user": "synthetic-user"
        }
      ],
      "cards": [
        {
          "type": "custom:layout-card",
          "layout_type": "custom:grid-layout",
          "layout": {
            "margin": 0,
            "padding": "22px",
            "grid-gap": "14px",
            "grid-template-columns": "repeat(12, minmax(0, 1fr))",
            "grid-template-rows": "calc((100vh - 88px - var(--kitchen-dashboard-header, 0px)) * 0.30) calc((100vh - 88px - var(--kitchen-dashboard-header, 0px)) * 0.27) calc((100vh - 88px - var(--kitchen-dashboard-header, 0px)) * 0.43)",
            "grid-template-areas": "\"header header header header header header header weather weather weather weather weather\"\n\n\"main main main cabinet cabinet cabinet climate climate climate climate climate climate\"\n\n\"media media media media media media security security security security security security\"",
            "place-content": "start stretch"
          },
          "cards": [
            {
              "type": "custom:echo-header-card",
              "view_layout": {
                "grid-area": "header"
              },
              "templates": {
                "title": "Kitchen",
                "time": "{{ now().strftime('%I:%M %p').lstrip('0') }}",
                "date": "{{ now().strftime('%A, %B') }} {{ now().day }}",
                "greeting": "{{ 'Good morning' if now().hour < 12 else 'Good afternoon' if now().hour < 17 else 'Good evening' }}"
              }
            },
            {
              "type": "custom:echo-weather-card",
              "entity": "weather.demo_13",
              "view_layout": {
                "grid-area": "weather"
              },
              "templates": {
                "label": "Outside",
                "condition": "{{ 'Partly Cloudy' if states(entity) == 'partlycloudy' else states(entity) | replace('-', ' ') | title }}",
                "temperature": "{% set value = state_attr(entity, 'temperature') %}{{ (value | round(0) | int | string) ~ (state_attr(entity, 'temperature_unit') or temperature_unit) if value is number else '--' }}",
                "humidity": "{% set value = state_attr(entity, 'humidity') %}{{ 'Humidity ' ~ value ~ '%' if value is not none else '' }}",
                "icon": "{{ {'clear-night': 'mdi:weather-night', 'sunny': 'mdi:weather-sunny', 'partlycloudy': 'mdi:weather-partly-cloudy', 'cloudy': 'mdi:weather-cloudy', 'rainy': 'mdi:weather-rainy', 'pouring': 'mdi:weather-pouring', 'snowy': 'mdi:weather-snowy', 'lightning': 'mdi:weather-lightning'}.get(states(entity), 'mdi:weather-partly-cloudy') }}"
              }
            },
            {
              "type": "custom:echo-toggle-card",
              "entity": "switch.demo_12",
              "name": "Main Lights",
              "icon": "mdi:ceiling-light-multiple",
              "view_layout": {
                "grid-area": "main"
              }
            },
            {
              "type": "custom:echo-toggle-card",
              "entity": "light.demo_7",
              "name": "Cabinet Lights",
              "icon": "mdi:led-strip-variant",
              "view_layout": {
                "grid-area": "cabinet"
              }
            },
            {
              "type": "custom:echo-climate-card",
              "hvac_modes": [
                "cool",
                "heat"
              ],
              "entity": "climate.demo_1",
              "icon": "mdi:thermometer",
              "view_layout": {
                "grid-area": "climate"
              },
              "templates": {
                "title": "Home Temperature",
                "status": "{{ states(entity) | capitalize }}{% if not config.get('show_temperature_control', false) %} \u00b7 {% set value = state_attr(entity, 'temperature') %}{{ (value | round(0) | int | string) ~ temperature_unit if value is number else '--' ~ temperature_unit }}{% endif %}",
                "target_temperature": "{% set value = state_attr(entity, 'target_temp_low' if config.get('temperature_target') == 'low' else 'target_temp_high' if config.get('temperature_target') == 'high' else 'temperature') %}{{ ('%g' | format(value | round(3))) ~ temperature_unit if value is number else '\u2014' }}",
                "current_temperature": "{% set value = state_attr(entity, 'current_temperature') %}{% if config.get('show_temperature_control', false) %}Current {{ ('%g' | format(value)) ~ temperature_unit if value is number else '\u2014' ~ temperature_unit }}{% else %}{{ (value | round(0) | int | string) ~ temperature_unit if value is number else '--' }}{% endif %}",
                "target_label": "{{ 'Heat to' if config.get('temperature_target') == 'low' else 'Cool to' if config.get('temperature_target') == 'high' else 'Set to' }}",
                "hint": "Tap to adjust"
              }
            },
            {
              "type": "custom:echo-media-card",
              "entity": "media_player.demo_11",
              "view_layout": {
                "grid-area": "media"
              }
            },
            {
              "type": "custom:echo-container-card",
              "title": "Security",
              "icon": "mdi:shield-home-outline",
              "columns": 3,
              "square": false,
              "cards": [
                {
                  "type": "custom:echo-entity-card",
                  "entity": "lock.demo_9",
                  "name": "Front Door",
                  "vertical": true,
                  "tap_action": {
                    "action": "more-info"
                  },
                  "hold_action": {
                    "action": "more-info"
                  },
                  "icon_tap_action": {
                    "action": "more-info"
                  },
                  "icon_hold_action": {
                    "action": "more-info"
                  }
                },
                {
                  "type": "custom:echo-entity-card",
                  "entity": "lock.demo_8",
                  "name": "Back Door",
                  "vertical": true,
                  "tap_action": {
                    "action": "more-info"
                  },
                  "hold_action": {
                    "action": "more-info"
                  },
                  "icon_tap_action": {
                    "action": "more-info"
                  },
                  "icon_hold_action": {
                    "action": "more-info"
                  }
                },
                {
                  "type": "custom:echo-entity-card",
                  "entity": "cover.demo_2",
                  "name": "Garage",
                  "icon": "mdi:garage",
                  "vertical": true,
                  "tap_action": {
                    "action": "more-info"
                  },
                  "hold_action": {
                    "action": "more-info"
                  },
                  "icon_tap_action": {
                    "action": "more-info"
                  },
                  "icon_hold_action": {
                    "action": "more-info"
                  }
                }
              ],
              "view_layout": {
                "grid-area": "security"
              }
            }
          ]
        }
      ]
    },
